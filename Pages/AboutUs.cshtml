@page
@model AboutUsModel
@{
    ViewData["Title"] = "About Us - Abinaya Garment Shop";
}

<!-- Hero Section -->
<section class="hero" style="min-height: 400px;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1>About Abinaya Shop</h1>
                <p class="subtitle" style="margin-top: 1.5rem;">Your trusted partner for premium cotton apparel wholesale solutions</p>
            </div>
            <div class="col-lg-6">
                <div class="hero-image">
                    <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600" alt="About Abinaya" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Business Introduction -->
<section class="container mt-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1599122954975-e4da3b5b4356?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=500" alt="Cotton Apparel" class="img-fluid rounded" style="box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
        </div>
        <div class="col-lg-6 ps-lg-5">
            <h2>Our Business</h2>
            <p>Abinaya Garment Shop is a Tiruppur-based cotton apparel wholesale business focused on providing quality garment collections for retailers, resellers, distributors and bulk buyers. We aim to make apparel sourcing convenient through product variety, reliable service and direct customer communication.</p>
            <p>Located in Tiruppur, Tamil Nadu—India's leading textile manufacturing hub—we leverage our strategic location and industry expertise to deliver premium cotton apparel at competitive wholesale prices.</p>
            <ul style="list-style: none; padding: 0; margin-top: 1.5rem;">
                <li style="margin-bottom: 1rem; display: flex; gap: 0.75rem;">
                    <span style="color: var(--accent-color); font-weight: bold;">✓</span>
                    <span>Premium quality cotton garments for wholesale distribution</span>
                </li>
                <li style="margin-bottom: 1rem; display: flex; gap: 0.75rem;">
                    <span style="color: var(--accent-color); font-weight: bold;">✓</span>
                    <span>Diverse product range for men, women, and children</span>
                </li>
                <li style="margin-bottom: 1rem; display: flex; gap: 0.75rem;">
                    <span style="color: var(--accent-color); font-weight: bold;">✓</span>
                    <span>Flexible bulk ordering and competitive pricing</span>
                </li>
                <li style="margin-bottom: 1rem; display: flex; gap: 0.75rem;">
                    <span style="color: var(--accent-color); font-weight: bold;">✓</span>
                    <span>Direct communication and personalized service</span>
                </li>
            </ul>
        </div>
    </div>
</section>

<!-- Our Commitment to Quality -->
<section class="bg-light-accent mt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 order-lg-2">
                <img src="https://images.unsplash.com/photo-1559827260-dc66d52bef19?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=500" alt="Quality Assurance" class="img-fluid rounded" style="box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            </div>
            <div class="col-lg-6 order-lg-1 pe-lg-5">
                <h2>Our Commitment to Quality</h2>
                <p>Quality is at the heart of everything we do. Every garment that leaves our facility undergoes stringent quality checks to ensure it meets our high standards and your customer expectations.</p>
                <p>We work closely with trusted manufacturers to source premium cotton fabric and ensure that each piece of apparel is crafted with attention to detail, comfort, and durability.</p>
                <div class="mt-4 pt-2">
                    <h5 style="color: var(--primary-color); margin-bottom: 1rem;">Quality Assurance</h5>
                    <ul style="list-style: none; padding: 0;">
                        <li style="margin-bottom: 0.8rem; color: var(--secondary-color);">
                            <i class="fas fa-check-circle" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                            Premium cotton fabric selection
                        </li>
                        <li style="margin-bottom: 0.8rem; color: var(--secondary-color);">
                            <i class="fas fa-check-circle" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                            Rigorous quality inspections
                        </li>
                        <li style="margin-bottom: 0.8rem; color: var(--secondary-color);">
                            <i class="fas fa-check-circle" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                            Consistent stitching and finishing
                        </li>
                        <li style="margin-bottom: 0.8rem; color: var(--secondary-color);">
                            <i class="fas fa-check-circle" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                            Comfortable, durable wear
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Product Focus -->
<section class="container mt-5">
    <div class="section-title">
        <h2>Our Product Focus</h2>
        <p>We specialize in quality cotton apparel across multiple categories</p>
    </div>
    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div style="background: linear-gradient(135deg, var(--accent-color), var(--hover-color)); padding: 2rem; text-align: center; color: white; border-radius: 0.5rem 0.5rem 0 0;">
                    <i class="fas fa-tshirt" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                    <h5>Men's Wear</h5>
                </div>
                <div class="card-body">
                    <p>Premium cotton t-shirts, polo shirts, casual wear, and formal apparel for men.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div style="background: linear-gradient(135deg, var(--accent-color), var(--hover-color)); padding: 2rem; text-align: center; color: white; border-radius: 0.5rem 0.5rem 0 0;">
                    <i class="fas fa-female" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                    <h5>Women's Wear</h5>
                </div>
                <div class="card-body">
                    <p>Elegant cotton t-shirts, casual wear, and stylish apparel designed for women.</p>
                </div>
