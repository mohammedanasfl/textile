@page
@model IndexModel
@{
    ViewData["Title"] = "Home - Abinaya Garment Shop";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <h1>Tiruppur's Trusted Garment Wholesale Partner</h1>
                <p class="subtitle">Premium cotton apparel manufacturing and wholesale supply for retailers, distributors, and bulk buyers across India.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Products" class="btn btn-primary">Explore Products</a>
                    <a asp-page="/ContactUs" class="btn btn-secondary">Request Quote</a>
                </div>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <div class="hero-image">
                    <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=900" alt="Tiruppur garment manufacturing" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container">
    <div class="section-title">
        <h2>Why Buyers Choose Abinaya Garment Shop</h2>
        <p>We combine Tiruppur production strength with reliable service and consistent quality for wholesale garment sourcing.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="feature-box h-100">
                <div class="feature-icon"><i class="fas fa-tshirt"></i></div>
                <h4>Quality Cotton Apparel</h4>
                <p>Comfortable, durable, and export-grade fabric selection for all categories.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-box h-100">
                <div class="feature-icon"><i class="fas fa-boxes-stacked"></i></div>
                <h4>Bulk Order Capacity</h4>
                <p>Scalable production and dispatch support for large B2B requirements.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-box h-100">
                <div class="feature-icon"><i class="fas fa-tags"></i></div>
                <h4>Wholesale Pricing</h4>
                <p>Competitive rates with clear communication and transparent order terms.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="feature-box h-100">
                <div class="feature-icon"><i class="fas fa-truck-fast"></i></div>
                <h4>On-Time Delivery</h4>
                <p>Structured order tracking and reliable shipment timelines for every order.</p>
            </div>
        </div>
    </div>
</section>

<section class="bg-light-accent">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2>Complete Garment Categories for Wholesale</h2>
                <p>From basic essentials to trend-focused collections, we serve retailers with ready-to-sell products in men, women, and kids segments.</p>
                <ul style="list-style: none; padding-left: 0; margin-top: 1.5rem;">
                    <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Men's wear: T-shirts, polos, and casuals</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Women's wear: tops, tees, and daily essentials</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Kids wear: safe, soft, and comfortable cotton collections</li>
                    <li class="mb-2"><i class="fas fa-check-circle text-accent me-2"></i> Custom logo and bulk branding options</li>
                </ul>
                <a asp-page="/Gallery" class="btn btn-outline mt-2">View Gallery</a>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <div class="hero-image">
                    <img src="https://images.unsplash.com/photo-1523381210434-271e8be1f52b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=900" alt="Garment product range" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container text-center">
    <div class="section-title mb-4">
        <h2>Start Your Tiruppur Sourcing with Confidence</h2>
        <p>Share your quantity and product requirements. Our team will provide the best wholesale options and pricing support.</p>
    </div>
    <div class="d-flex flex-wrap justify-content-center gap-3">
        <a asp-page="/ContactUs" class="btn btn-primary">Get Business Quote</a>
        <a href="https://wa.me/?text=Hello%20Abinaya%20Garment%20Shop%2C%20I%20need%20wholesale%20garment%20details%20from%20Tiruppur." target="_blank" class="btn btn-whatsapp">
            <i class="fab fa-whatsapp"></i>
            WhatsApp Now
        </a>
    </div>
</section>
