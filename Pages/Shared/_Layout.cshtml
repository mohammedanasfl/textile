<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Abinaya Garment Shop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1swe.styles.css" asp-append-version="true" />
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVJkEZSMUkrQ6usKu8zQwAsSYYzJtBvTQQX2VJcT5lh9DS5koIrqenI7+9DyWCVDSpE51RBuxY+g==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light" style="padding: 1rem 0;">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <strong>Abinaya Garment Shop</strong>
                    <small style="font-size: 0.75rem; color: var(--accent-color);">Premium Cotton Paradise</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Products">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Gallery">Gallery</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/ContactUs">Contact Us</a>
                        </li>
                    </ul>
                    <a class="btn btn-whatsapp ms-3" href="https://wa.me/?text=Hello%20Abinaya%20Garment%20Shop%2C%20I%20am%20interested%20in%20your%20cotton%20apparel%20wholesale%20collections.%20Please%20share%20your%20product%20details%20and%20wholesale%20pricing." target="_blank">
                        <i class="fab fa-whatsapp"></i>
                        WhatsApp
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h5>Abinaya Garment Shop</h5>
                    <p style="font-size: 0.95rem;">Premium cotton apparel wholesale supplier based in Tiruppur, Tamil Nadu. Quality garments for retailers, distributors, and bulk buyers.</p>
                </div>
                <div class="footer-section">
                    <h5>Quick Links</h5>
                    <ul>
                        <li><a asp-area="" asp-page="/Index">Home</a></li>
                        <li><a asp-area="" asp-page="/AboutUs">About Us</a></li>
                        <li><a asp-area="" asp-page="/Products">Products</a></li>
                        <li><a asp-area="" asp-page="/Gallery">Gallery</a></li>
                        <li><a asp-area="" asp-page="/ContactUs">Contact Us</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h5>Contact Info</h5>
                    <p style="font-size: 0.95rem;">
                        <i class="fas fa-map-marker-alt"></i> 8/76, Angeripalayam Road, Tiruppur, Tamil Nadu, India.<br>
                        <i class="fas fa-phone"></i> <a href="tel:+91-XXXXXXXXXX">+91-XXXXXXXXXX</a><br>
                        <i class="fas fa-whatsapp"></i> <a href="https://wa.me/?text=Hello%20Abinaya%20Garment%20Shop%2C%20I%20am%20interested%20in%20your%20cotton%20apparel%20wholesale%20collections.%20Please%20share%20your%20product%20details%20and%20wholesale%20pricing." target="_blank">WhatsApp Inquiry</a><br>
                        <i class="fas fa-envelope"></i> <a href="mailto:contact@abinayagarments.com">contact@abinayagarments.com</a>
                    </p>
                </div>
            </div>
            <div class="footer-bottom">
                <p style="margin: 0;">&copy; 2026 Abinaya Garment Shop. All Rights Reserved. | Premium Cotton Apparel Wholesale</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
